---
import Stage from './Stage.astro';
import '../styles/guild.css';
import type { Property } from '../lib/links';
interface Props {
  title: string;
  description: string;
  property?: Property;
  path?: string;
  noindex?: boolean;
  current?: 'engine' | 'docs' | 'models';
}
const { title, description, property = 'guild', path = '', noindex = false, current } = Astro.props;
---

<Stage {title} {description} {property} {path} {noindex} {current} theme="#0f1110">
  <main id="main" class="sitebody">
    <slot />
  </main>
</Stage>
