---
import Stage from '../layouts/Stage.astro';
import '../styles/guild.css';
import '../styles/surface.css';
import snapshot from '../data/generated/sources.json';
import { models } from '../data/models';
import { link } from '../lib/links';
import { pinned, tag, source } from '../lib/source';

const qwenEntry = models[0];
const qwen = qwenEntry.registry!;
const gib = (qwen.bytes / 2 ** 30).toFixed(2);
// The help lookup lists only the commands in the README's command block at the pinned release.
const readme = snapshot.documents.find((d) => d.path === 'README.md')!.markdown;
const block =
  [...readme.matchAll(/```[a-z]*\n([\s\S]*?)```/g)]
    .map((m) => m[1])
    .find((b) => b.startsWith('guild ') && b.includes('guild pull <model>')) ?? '';
const commands = block
  .trim()
  .split('\n')
  .map((line) => {
    const [, usage, what] = line.match(/^(guild \S+(?: [<[][^>\]]+[>\]])?)\s{2,}(.+)$/) ?? [];
    return usage ? { usage, what } : null;
  })
  .filter((c): c is { usage: string; what: string } => c !== null);
// Installer at the pinned release, and the SHA-256 of that exact file.
const installer = `https://raw.githubusercontent.com/guild-inference/Guild/${tag}/install.sh`;
const installerSha = '1c596ad770713eed7c2e3a5df72f9cde30880371eb3b357263a7f2a1d7527095';
const steps = [
  ['file', 'Open the model file', `${gib} GiB, memory-mapped`],
  ['gpu', 'Dense path, attention state, scratch', 'GPU 0, 7,310 MiB sampled'],
  ['ram', 'Routed experts', 'System RAM'],
  ['kv', 'KV cache', 'Host memory, FP16'],
  ['cpu', 'Expert matmuls', 'CPU threads, 10 experts per token per layer'],
];
const runs = [
  {
    name: 'Qwen3.8-Flash-Next',
    quant: 'UD-IQ4_XS',
    workload: 'W3, JSON schema',
    tokens: '256 / 64',
    scale: 40,
    bars: [
      ['Normal', 18.33, '18.33'],
      ['Fixed, MTP', 23.43, '23.43'],
      ['Adaptive', 23.52, '23.52'],
    ],
  },
  {
    name: 'Ornith 1.5 35B',
    quant: 'Q4_K_M',
    workload: 'W2, summarization',
    tokens: '256 / 128',
    scale: 90,
    bars: [
      ['Normal', 50.27, '50.27'],
      ['Fixed, lookup', 82.19, '82.19'],
      ['Adaptive', 80.84, '80.08 to 80.84'],
    ],
  },
  {
    name: 'Ornith 1.5 35B',
    quant: 'Q4_K_M',
    workload: 'W7, creative prose',
    tokens: '256 / 128',
    scale: 90,
    bars: [
      ['Normal', 49.75, '49.75'],
      ['Fixed, lookup', 48.84, '48.84'],
      ['Adaptive', 49.18, '49.10 to 49.18'],
    ],
  },
] as const;
const views = [
  ['inspect', 'Inspect'],
  ['plan', 'Plan'],
  ['decode', 'Decode'],
  ['desktop', 'Desktop'],
  ['serve', 'Serve'],
];
---

<Stage
  property="guild"
  title="Guild: an 87 GiB model on an 8 GiB graphics card"
  description="Guild is a native, open-source Mixture-of-Experts inference engine. It runs large models across GPU memory, system RAM and CPU threads, with portable GPACK and machine-specific GEXEC."
  theme="#0f1110"
  current="engine"
>
  <div class="app">
    <aside class="rail" aria-label="Guild">
      <a class="rail__mark" href={link('guild')}>Guild</a>
      <p class="rail__sub">Mixture-of-Experts inference engine. Open source, MIT.</p>
      <nav class="rail__views" aria-label="On this page">
        {
          views.map(([id, label]) => (
            <a href={`#${id}`} data-view-link={id}>
              {label}
            </a>
          ))
        }
      </nav>
    </aside>

    <main id="main" class="surface">
      <section id="inspect" class="view inspect" data-view="inspect">
        <p class="viewbar"><b>inspect</b> {qwen.name} · registry at Guild {pinned}</p>
        <div class="inspect__top">
          <div>
            <h1>An {gib.split('.')[0]} GiB model on an 8 GiB graphics card.</h1>
            <p class="inspect__ram">
              On a big-RAM server: <b>376 GiB of system RAM</b>, 2× Xeon Gold 6130, GTX 1070 8 GiB.
            </p>
            <p class="inspect__lede">
              Guild runs Mixture-of-Experts models across GPU memory, system RAM and CPU threads.
              The experts live in system RAM, which is why this run had so much of it.
            </p>
            <p class="inspect__actions">
              <a class="cta" href={link('docs', 'getting-started/')}>Start your first run</a>
              <a href={link('models')}>Supported models</a>
            </p>
          </div>
          <dl class="readout" data-sc-in data-sc-stagger="45">
            <div><dt>Display name</dt><dd>{qwenEntry.name}</dd></div>
            <div>
              <dt>Model id</dt><dd><code>{qwen.name}</code></dd>
            </div>
            <div>
              <dt>Architecture tag</dt><dd><code>{qwen.architecture}</code></dd>
            </div>
            <div>
              <dt>Size on disk</dt>
              <dd><span data-sc-count={`0 ${gib}`}>{gib}</span> GiB</dd>
            </div>
            <div><dt>Quantization</dt><dd>{qwen.quantization}</dd></div>
            <div><dt>Routed experts</dt><dd>{qwen.experts}</dd></div>
            <div><dt>Per token, plus shared</dt><dd>{qwen.activeExperts} + 1</dd></div>
            <div><dt>Layers</dt><dd>{qwen.layers}</dd></div>
            <div><dt>Context metadata</dt><dd>{qwen.context.toLocaleString('en-US')}</dd></div>
            <div><dt>Type</dt><dd>{qwenEntry.type}</dd></div>
          </dl>
        </div>
        <figure class="layers">
          <div class="layers__strip" aria-hidden="true">
            {
              Array.from({ length: qwen.layers }, (_, i) => (
                <i class={(i + 1) % 4 === 0 ? 'att' : ''} />
              ))
            }
          </div>
          <figcaption>
            {qwen.layers} layers: 36 Gated DeltaNet, and every fourth one attention (12 in all), per
            <a href={link('docs', 'model-runners/')}>the Qwen3.8 runner</a>.
          </figcaption>
        </figure>
      </section>

      <section
        id="plan"
        class="view plan"
        data-view="plan"
        data-sc-act="pin"
        data-sc-span="3.2"
        aria-labelledby="plan-title"
      >
        <div class="plan__stage" data-sc-stage data-plan-stage>
          <div class="plan__side">
            <p class="viewbar"><b>plan</b> the measured host</p>
            <h2 id="plan-title">Where the model goes.</h2>
            <ol class="steps">
              {
                steps.map(([key, what, where]) => (
                  <li data-step={key}>
                    <span>{what}</span>
                    <b>{where}</b>
                  </li>
                ))
              }
            </ol>
            <p class="plan__note">
              Phase 6 run: 4,096-token prompt, 32,768 capacity, host-only FP16 KV. The VRAM figure
              is a sample from that run, not a minimum. Amounts in system RAM depend on free memory.
            </p>
          </div>
          <div class="host" aria-hidden="true">
            <div class="part part--gpu" data-part="gpu">
              <p class="part__name">GPU 0 <span>GeForce GTX 1070</span></p>
              <div class="gauge"><i style="--fill: 0.8924"></i></div>
              <p class="part__scale"><span>7,310 MiB sampled</span><span>8 GiB</span></p>
            </div>
            <div class="cpus">
              {
                [0, 1].map((n) => (
                  <div class="part part--cpu" data-part="cpu">
                    <p class="part__name">
                      CPU {n} <span>Xeon Gold 6130</span>
                    </p>
                    <div class="cores">
                      {Array.from({ length: 16 }, () => (
                        <i />
                      ))}
                    </div>
                  </div>
                ))
              }
            </div>
            <div class="part part--ram" data-part="ram">
              <p class="part__name">System RAM <span>376 GiB, two NUMA nodes</span></p>
              <div class="gauge gauge--ram">
                <i class="gauge__experts" style={`--fill: ${(Number(gib) / 376).toFixed(4)}`}></i>
                <i class="gauge__kv" style={`--at: ${(Number(gib) / 376).toFixed(4)}`}></i>
              </div>
              <p class="part__scale">
                <span>routed experts, up to the file's {gib} GiB</span><span>KV cache</span>
              </p>
            </div>
            <div class="part part--file" data-part="file">
              <p class="part__name">Model file <span>{qwen.quantization}, memory-mapped</span></p>
              <div class="gauge"><i style="--fill: 1"></i></div>
              <p class="part__scale"><span>{gib} GiB</span><span>disk</span></p>
            </div>
          </div>
        </div>
      </section>

      <section id="decode" class="view decode" data-view="decode" aria-labelledby="decode-title">
        <p class="viewbar"><b>decode</b> Phase 6.6.1 · measured tokens per second</p>
        <h2 id="decode-title">Faster where the text allows it. Not everywhere.</h2>
        <p class="decode__config">
          Decode tokens per second, greedy, GEXEC active, CPU expert path, max draft 4. 2× Xeon Gold
          6130, 376 GiB RAM, GTX 1070 8 GiB. Prompt / generated tokens per row.
        </p>
        <div class="decode__runs">
          {
            runs.map((r) => (
              <article class="trace" data-trace>
                <h3>
                  {r.name} <span>{r.workload}</span>
                </h3>
                <p class="trace__meta">
                  {r.quant} · {r.tokens} · scale 0 to {r.scale} tok/s
                </p>
                <dl>
                  {r.bars.map(([label, value, shown]) => (
                    <div
                      class={value === Math.max(...r.bars.map((b) => b[1])) ? 'is-best' : undefined}
                    >
                      <dt>{label}</dt>
                      <dd class="trace__bar" aria-hidden="true">
                        <i style={`--v:${(value / r.scale).toFixed(4)}`} />
                      </dd>
                      <dd>{shown}</dd>
                    </div>
                  ))}
                </dl>
              </article>
            ))
          }
        </div>
        <p class="decode__more">
          The third run is a loss: on new prose there is little to predict, and adaptive decoding
          stays below normal. <a href={link('guild', 'performance/')}
            >The measurement and its limits</a
          >
        </p>
      </section>

      <section
        id="desktop"
        class="view desktop"
        data-view="desktop"
        aria-labelledby="desktop-title"
      >
        <p class="viewbar"><b>desktop</b> not measured yet</p>
        <h2 id="desktop-title">On a normal desktop.</h2>
        <div class="desktop__grid">
          <p>
            Every Guild number on this site comes from the big-RAM server above. The phase reports
            name the desktop to measure next: Ryzen 5 5600X, 32 GiB DDR4, RTX 5070 12 GiB. They list
            it as pending hardware access, and nothing here is extrapolated to it.
          </p>
          <p>
            With less system RAM than the model file, Guild still plans the run and warns: the
            experts are file-backed, so the operating system pages them from disk (<a
              href={source('src/memory/planner.cpp', '#L350')}>planner.cpp</a
            >). How fast that is on a desktop has not been measured.
          </p>
          <p class="todo">
            TODO: measure Qwen3.8 and Ornith on this desktop, with full configuration.
          </p>
        </div>
      </section>

      <section id="serve" class="view serve" data-view="serve" aria-labelledby="serve-title">
        <p class="viewbar"><b>serve</b> your machine</p>
        <h2 id="serve-title">An OpenAI-compatible endpoint on your own machine.</h2>
        <div class="serve__grid">
          <div class="serve__code">
            <div class="code-box">
              <div class="code-box__bar">
                <span>Linux, x86-64 · Guild {tag}</span>
                <button type="button" class="btn-copy" data-copy="install-code">Copy</button>
              </div>
              <pre
                tabindex="0"><code id="install-code">curl -fsSL {installer} | GUILD_VERSION={tag} bash
guild pull {qwen.name}
guild serve {qwen.name}</code></pre>
              <div class="code-box__bar code-box__bar--end">
                <span
                  >The download is {gib} GiB. Then point a client at
                  <code>http://127.0.0.1:11434/v1</code>, or pick a port with
                  <code>--port</code>.</span
                >
              </div>
            </div>
            <div class="code-box">
              <div class="code-box__bar">
                <span>Or download, inspect, then run</span>
                <button type="button" class="btn-copy" data-copy="inspect-code">Copy</button>
              </div>
              <pre
                tabindex="0"><code id="inspect-code">curl -fsSLO {installer}
echo "{installerSha}  install.sh" | sha256sum -c
less install.sh
GUILD_VERSION={tag} bash install.sh</code></pre>
            </div>
            <dl class="routes">
              <div>
                <dt><code>/v1</code></dt>
                <dd>
                  OpenAI compatibility layer in <code>guild serve</code>: chat completions,
                  completions, responses and models.
                </dd>
              </div>
              <div>
                <dt><code>/health</code></dt>
                <dd>Health check, also at <code>/api/health</code>.</dd>
              </div>
              <div>
                <dt><code>/api</code></dt>
                <dd>
                  Ollama compatibility is not in {tag}. <span class="todo">TODO: planned?</span>
                </dd>
              </div>
              <div>
                <dt><code>/v0</code></dt>
                <dd>Native API: planned, not in {tag}. <span class="todo">TODO</span></dd>
              </div>
              <div>
                <dt><code>/v1/messages</code></dt>
                <dd>
                  Anthropic Messages is served only by the Python server, <code
                    >serve/server.py</code
                  >
                  (port 8095 by default), not by <code>guild serve</code>.
                </dd>
              </div>
            </dl>
            <p class="todo">
              TODO: 48453 replaces 11434 as the default port in the next release, once it ships.
            </p>
          </div>
          <form class="lookup" role="search" data-lookup>
            <label for="lookup">Look up a command</label>
            <div class="lookup__field">
              <span aria-hidden="true">guild</span>
              <input
                id="lookup"
                type="search"
                autocomplete="off"
                spellcheck="false"
                placeholder="serve"
                aria-describedby="lookup-help"
              />
            </div>
            <p id="lookup-help" class="lookup__help">
              Describes the commands in the README at {tag}. It does not run anything.
            </p>
            <ul class="lookup__list" id="lookup-list">
              {
                commands.map((c) => (
                  <li data-usage={c.usage.toLowerCase()}>
                    <code>{c.usage}</code>
                    <span>{c.what}</span>
                  </li>
                ))
              }
            </ul>
            <p class="lookup__empty" id="lookup-empty" role="status" hidden>
              Not a documented command. See the <a href={link('docs', 'cli/')}>CLI reference</a>.
            </p>
          </form>
        </div>
        <p class="links">
          <a href={link('docs', 'serving/')}>Serving guide</a>
          <a href={link('docs', 'cli/')}>CLI reference</a>
          <a href={source('README.md')}>README at {tag} ↗</a>
        </p>
      </section>
    </main>

    <p class="status" aria-hidden="true">
      <span>Guild {pinned}</span>
      <span>{qwen.name} {qwen.quantization}</span>
      <span>Measured host: 2× Xeon Gold 6130 · 376 GiB · GTX 1070 8 GiB</span>
      <span class="status__view" data-status-view>inspect</span>
    </p>
  </div>

  <script>
    import { actProgress, whileVisible, reduceMotion } from '../scripts/engine';

    // Plan: the placement runs in five steps across the pin. Each step fills its part of the
    // measured machine continuously with scroll; reduced motion shows each step whole.
    const plan = document.querySelector<HTMLElement>('#plan');
    const stage = document.querySelector<HTMLElement>('[data-plan-stage]');
    const order = ['file', 'gpu', 'ram', 'kv', 'cpu'];
    const START = 0.04;
    const EACH = 0.18;
    const cores = stage ? [...stage.querySelectorAll<HTMLElement>('.cores')] : [];
    let last = '';
    if (plan && stage)
      whileVisible(plan, () => {
        const p = actProgress(plan);
        const t = order.map((_, i) => {
          const v = Math.min(1, Math.max(0, (p - START - i * EACH) / EACH));
          return reduceMotion ? (v > 0 ? 1 : 0) : Math.round(v * 100) / 100;
        });
        const key = t.join(',');
        if (key === last) return;
        last = key;
        const step = t.findLastIndex((v) => v > 0);
        stage.dataset.step = String(step);
        stage.setAttribute('data-sc-verify-state', key);
        // Reduced motion shows each step whole, so the frames between steps are deliberately still.
        if (reduceMotion) stage.setAttribute('data-sc-verify-hold', 'true');
        order.forEach((name, i) => {
          stage.style.setProperty(`--t-${name}`, String(t[i]));
          const line = stage.querySelector(`[data-step="${name}"]`);
          line?.classList.toggle('is-done', i < step);
          line?.classList.toggle('is-now', i === step);
          stage
            .querySelectorAll(`[data-part="${name === 'kv' ? 'ram' : name}"]`)
            .forEach((part) => part.classList.toggle(`on-${name}`, t[i] > 0));
        });
        const lit = Math.round(t[4] * 16);
        cores.forEach((set) =>
          set.querySelectorAll('i').forEach((core, n) => core.classList.toggle('is-lit', n < lit)),
        );
      });

    // Decode: bars grow once, when their run comes into view.
    const traces = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('is-in');
          traces.unobserve(e.target);
        }),
      { rootMargin: '0px 0px -15% 0px' },
    );
    document.querySelectorAll('[data-trace]').forEach((t) => traces.observe(t));

    // The rail and the status bar follow the view in front of the reader.
    const links = document.querySelectorAll<HTMLElement>('[data-view-link]');
    const statusView = document.querySelector('[data-status-view]');
    const viewObserver = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const id = (e.target as HTMLElement).dataset.view;
          links.forEach((l) => {
            if (l.dataset.viewLink === id) l.setAttribute('aria-current', 'location');
            else l.removeAttribute('aria-current');
          });
          if (statusView && id) statusView.textContent = id;
        }),
      { rootMargin: '-45% 0px -50% 0px' },
    );
    document.querySelectorAll('[data-view]').forEach((v) => viewObserver.observe(v));

    // Serve: the command lookup filters the documented commands as you type.
    const lookup = document.querySelector<HTMLInputElement>('#lookup');
    const empty = document.querySelector<HTMLElement>('#lookup-empty');
    lookup?.addEventListener('input', () => {
      const q = lookup.value
        .trim()
        .toLowerCase()
        .replace(/^guild\s+/, '');
      let n = 0;
      document.querySelectorAll<HTMLElement>('#lookup-list li').forEach((li) => {
        const hit = !q || li.dataset.usage!.includes(q);
        li.hidden = !hit;
        if (hit) n++;
      });
      if (empty) empty.hidden = n > 0;
    });
    document.querySelector('[data-lookup]')?.addEventListener('submit', (e) => e.preventDefault());

    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
      button.addEventListener('click', async () => {
        const target = document.getElementById(button.dataset.copy || '');
        try {
          if (!target) throw new Error('Missing code');
          await navigator.clipboard.writeText(target.textContent || '');
          button.textContent = 'Copied';
        } catch {
          button.textContent = 'Select to copy';
        }
        setTimeout(() => {
          button.textContent = 'Copy';
        }, 2500);
      });
    });
  </script>
</Stage>
