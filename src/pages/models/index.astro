---
import Site from '../../layouts/Site.astro';
import { models } from '../../data/models';
import { link } from '../../lib/links';
import { pinned, source } from '../../lib/source';
---

<Site
  property="models"
  current="models"
  title="Guild Models: compatibility, with context"
  description="A source-backed Guild model catalog with explicit supported, experimental, planned and research status. Actual registry metadata, upstream checks and memory evidence."
>
  <div class="page">
    <header class="head">
      <p class="head__meta">Model catalog · Guild {pinned}</p>
      <h1>Compatibility, with context.</h1>
      <p class="head__lede">
        Two built-in registry models, and clear boundaries around what runs, what is planned and
        what is still a research question.
      </p>
    </header>
    <div class="note">
      <strong>Supported</strong> means Guild's primary development target, not a guarantee for every quantization
      or hardware configuration. <strong>Experimental</strong> entries have a development execution path.
      <strong>Planned</strong> entries describe architecture work. <strong>Research</strong> entries have
      no released weights.
    </div>
    <div class="filters">
      <label
        >Search models<input
          id="model-search"
          type="search"
          placeholder="Name, architecture, quantization…"
        /></label
      >
      <label
        >Compatibility status<select id="model-stage"
          ><option>All statuses</option>{
            ['Supported', 'Experimental', 'Planned', 'Research'].map((s) => <option>{s}</option>)
          }</select
        ></label
      >
    </div>
    <p id="model-count" role="status">{models.length} entries</p>
    <ul class="catalog">
      {
        models.map((m) => (
          <li
            class="entry"
            data-model-card
            data-stage={m.stage}
            data-search={`${m.name} ${m.modelId ?? ''} ${m.architecture} ${m.type} ${m.registry?.quantization || ''}`.toLowerCase()}
          >
            <div>
              <h2>{m.name}</h2>
              <span class="stage" data-stage={m.stage}>
                {`${m.stage}, ${m.registry ? 'registry model' : 'family'}`}
              </span>
            </div>
            <div>
              <p>{m.summary}</p>
              <ul class="entry__facts">
                <li>
                  <span class="k">type</span> {m.type}
                </li>
                {m.modelId && (
                  <li>
                    <span class="k">model id</span> {m.modelId}
                  </li>
                )}
                <li>
                  <span class="k">arch</span> {m.architecture}
                </li>
                {m.registry && <li>{m.registry.quantization}</li>}
                {m.registry && (
                  <li>
                    {m.registry.activeExperts} of {m.registry.experts} experts per token
                  </li>
                )}
                {m.registry && <li>{(m.registry.bytes / 2 ** 30).toFixed(2)} GiB</li>}
              </ul>
            </div>
            <a class="entry__link" href={link('models', `${m.id}/`)}>
              View compatibility & sources
            </a>
          </li>
        ))
      }
    </ul>
    <p class="empty" id="model-empty" hidden>
      No matching entries. Try a different search or status.
    </p>
    <p class="source-line">
      Registry fields are extracted at build time from <a href={source('src/models/registry.cpp')}
        >registry.cpp</a
      >. Status follows the <a href={source('README.md')}>pinned README</a>. Hub metadata checked 22
      October 2026.
    </p>
  </div>
  <script>
    const search = document.querySelector<HTMLInputElement>('#model-search')!;
    const stage = document.querySelector<HTMLSelectElement>('#model-stage')!;
    function filter() {
      let count = 0;
      document.querySelectorAll<HTMLElement>('[data-model-card]').forEach((card) => {
        card.hidden = !(
          card.dataset.search!.includes(search.value.trim().toLowerCase()) &&
          (stage.value === 'All statuses' || card.dataset.stage === stage.value)
        );
        if (!card.hidden) count++;
      });
      document.querySelector('#model-count')!.textContent =
        `${count} ${count === 1 ? 'entry' : 'entries'}`;
      document.querySelector<HTMLElement>('#model-empty')!.hidden = count > 0;
    }
    search.addEventListener('input', filter);
    stage.addEventListener('change', filter);
  </script>
</Site>
