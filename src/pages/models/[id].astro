---
import Site from '../../layouts/Site.astro';
import { models } from '../../data/models';
import { link } from '../../lib/links';
import { source, revision } from '../../lib/source';
export function getStaticPaths() {
  return models.map((model) => ({ params: { id: model.id }, props: { model } }));
}
const { model: m } = Astro.props;
const r = m.registry;
---

<Site
  property="models"
  current="models"
  path={`${m.id}/`}
  title={`${m.name}: Guild model compatibility`}
  description={m.summary}
>
  <div class="page">
    <a class="back" href={link('models')}>← Model catalog</a>
    <header class="head" style="margin-top: var(--sc-5)">
      <span class="stage" data-stage={m.stage}
        >{`${m.stage}, ${r ? 'registry model' : 'family'}`}</span
      >
      <h1>{m.name}</h1>
      <p class="head__lede">{m.summary}</p>
    </header>
    <div class="spec">
      <div>
        <dl class="labels">
          <div><dt>Architecture</dt><dd>{m.architecture}</dd></div>
          <div><dt>Parameter count</dt><dd>{m.parameters}</dd></div>
          <div><dt>Active parameters</dt><dd>{m.activeParameters}</dd></div>
          <div>
            <dt>Formats</dt><dd>
              {
                r
                  ? 'GGUF input, GPACK container, optional GEXEC cache'
                  : 'No validated model artifact'
              }
            </dd>
          </div>
          {
            r && (
              <>
                <div>
                  <dt>Registry quantization</dt>
                  <dd>{r.quantization}</dd>
                </div>
                <div>
                  <dt>Registry size on disk</dt>
                  <dd>
                    {(r.bytes / 2 ** 30).toFixed(2)} GiB ({r.bytes.toLocaleString('en-US')} bytes)
                  </dd>
                </div>
                <div>
                  <dt>Layers, routed experts</dt>
                  <dd>
                    {r.layers} layers, {r.activeExperts} of {r.experts} experts active per layer
                  </dd>
                </div>
                <div>
                  <dt>Context metadata</dt>
                  <dd>{r.context.toLocaleString('en-US')} tokens (see runtime limits below)</dd>
                </div>
              </>
            )
          }
        </dl>
        <p class="source-line">
          Guild snapshot <a href={source('README.md')}>{revision.slice(0, 7)}</a>. Unknown fields
          are left unverified rather than estimated.
        </p>
      </div>
      <div>
        <section class="panel" aria-labelledby="availability">
          <h2 id="availability">Availability</h2>
          <p>{m.availability}</p>
          {
            m.upstream && (
              <p>
                <a href={m.upstream}>Verified upstream revision ↗</a>
              </p>
            )
          }
          {
            r && m.upstream && (
              <div class="code-box">
                <div class="code-box__bar">
                  <span>Registry command</span>
                  <button type="button" class="btn-copy" data-copy="pull-code">
                    Copy
                  </button>
                </div>
                <pre tabindex="0">
                  <code id="pull-code">{`guild pull ${r.name}`}</code>
                </pre>
              </div>
            )
          }
          {
            m.id === 'eon' && (
              <p>
                <a href={link('labs')}>Visit Guild Labs ↗</a>
              </p>
            )
          }
        </section>
        <div class="note">
          <strong>Memory evidence.</strong>
          {m.memory}
          {
            r && (
              <>
                {' '}
                Measured host: 2× Xeon Gold 6130, 376 GiB RAM, GTX 1070 8 GiB. System-RAM
                requirements are not established by sampled VRAM; context, KV and workspace choices
                matter. <a href={link('docs', 'hardware/')}>Hardware guidance</a>
              </>
            )
          }
        </div>
      </div>
    </div>
    <section class="notes" aria-labelledby="notes">
      <h2 id="notes">Compatibility notes</h2>
      <ul>
        {m.notes.map((note) => <li>{note}</li>)}
      </ul>
      <p class="links">
        {
          r ? (
            <>
              <a href={source('src/models/registry.cpp')}>Registry source ↗</a>
              <a href={link('docs', 'phase6/')}>Memory measurements</a>
            </>
          ) : m.stage === 'Planned' ? (
            <a href={source('src/model/archetype.cpp')}>Archetype source ↗</a>
          ) : null
        }
      </p>
    </section>
  </div>
  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
      button.addEventListener('click', async () => {
        const target = document.getElementById(button.dataset.copy || '');
        try {
          if (!target) throw new Error('Missing code');
          await navigator.clipboard.writeText(target.textContent || '');
          button.textContent = 'Copied';
        } catch {
          button.textContent = 'Select to copy';
        }
        setTimeout(() => {
          button.textContent = 'Copy';
        }, 2500);
      });
    });
  </script>
</Site>
