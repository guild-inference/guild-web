---
import Site from '../layouts/Site.astro';
import { link } from '../lib/links';
---

<Site
  title="Page not found: Guild"
  description="Return to Guild, its documentation or the model catalog."
  noindex
>
  <div class="page">
    <header class="head">
      <p class="head__meta">404 · not found</p>
      <h1>No such path in this build.</h1>
      <p class="head__lede">
        Try the <a href={link('guild')}>engine overview</a>, the <a href={link('docs')}
          >documentation</a
        > or the <a href={link('models')}>model catalog</a>.
      </p>
    </header>
  </div>
</Site>
