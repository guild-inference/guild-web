---
import Site from '../../layouts/Site.astro';
import DocsSidebar from '../../components/DocsSidebar.astro';
import { link } from '../../lib/links';
import { revision, source } from '../../lib/source';
import { docs } from '../../lib/docs';
const start = [
  ['getting-started', 'Your first run', 'Clone, build, choose a model and generate locally.'],
  ['installation', 'Build for your hardware', 'CUDA, HIP, CPU-only and Windows setup paths.'],
  ['hardware', 'Plan the memory', 'GPU memory, host RAM, KV cache and file-backed experts.'],
  ['cli', 'Use the CLI', 'The model store, inference, serving and execution artifacts.'],
  ['formats', 'Understand the formats', 'GGUF, the portable GPACK and the machine-specific GEXEC.'],
  ['serving', 'Serve locally', 'The OpenAI-compatible server and the Python server.'],
];
const imported = docs.filter((d) => d.imported).length;
---

<Site
  property="docs"
  current="docs"
  title="Guild Docs: from first run to runtime internals"
  description="Practical Guild guides and complete source-backed documentation, pinned to an immutable Core revision."
>
  <div class="docs docs--index">
    <DocsSidebar />
    <article class="article">
      <header class="head">
        <p class="head__meta">Documentation · Core {revision.slice(0, 7)}</p>
        <h1>Understand the engine. Make it yours.</h1>
        <p class="head__lede">
          Start with a local run, then go deeper into the memory planner, the model formats and the
          runtime contracts.
        </p>
      </header>
      <nav class="guide-index" aria-label="Start here">
        {
          start.map(([slug, title, description]) => (
            <a href={link('docs', `${slug}/`)}>
              <b>{title}</b>
              <span>{description}</span>
            </a>
          ))
        }
      </nav>
      <div class="note">
        <strong>A versioned reading room.</strong> Six web guides accompany {imported} complete repository
        documents. Imported documents are pinned to
        <a href={source('README.md')}>{revision.slice(0, 7)}</a>, with file hashes and source links.
        Updating Core does not silently rewrite this snapshot.
      </div>
      <p class="links">
        <a href={link('guild', 'performance/')}>Read the performance evidence notes</a>
      </p>
    </article>
  </div>
</Site>
