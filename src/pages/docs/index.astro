---
import Shell from '../../layouts/Shell.astro';
import DocsSidebar from '../../components/DocsSidebar.astro';
import { link } from '../../lib/links';
import { revision, source } from '../../lib/source';
---

<Shell
  property="docs"
  title="Guild Docs — From first run to runtime internals"
  description="Practical Guild guides and complete source-backed documentation, pinned to an immutable Core revision."
>
  <div class="wrap docs-layout">
    <DocsSidebar /><article class="docs-article">
      <header>
        <div class="eyebrow">Documentation / Core {revision.slice(0, 7)}</div><h1>
          Understand the engine.<br /><em>Make it yours.</em>
        </h1><p>
          Start with a local run. Go deeper into the memory planner, model formats, and runtime
          contracts.
        </p>
      </header><div class="grid-two">
        {
          [
            [
              'getting-started',
              'Your first run',
              'Clone, build, choose a model, and generate locally.',
            ],
            [
              'installation',
              'Build for your hardware',
              'CUDA, HIP, CPU-only, and Windows setup paths.',
            ],
            [
              'hardware',
              'Plan the memory',
              'GPU VRAM, host RAM, KV cache, and file-backed experts.',
            ],
            ['cli', 'Use the CLI', 'The model store, inference, serving, and execution artifacts.'],
            [
              'formats',
              'Understand the formats',
              'GGUF, portable GPACK, and machine-specific GEXEC.',
            ],
            ['serving', 'Serve locally', 'Native and Python API entry points.'],
          ].map(([slug, title, description]) => (
            <a class="paper" href={link('docs', `${slug}/`)}>
              <>
                <h2 style="font-family:var(--sans);font-size:18px;letter-spacing:-.03em">
                  {title} ↗
                </h2>
                <p>{description}</p>
              </>
            </a>
          ))
        }
      </div><div class="notice">
        <strong>A versioned reading room.</strong> Six web guides accompany 19 complete repository documents.
        Imported documents are pinned to <a href={source('README.md')}>{revision.slice(0, 7)}</a>,
        with file hashes and source links. Updating Core does not silently rewrite this snapshot.
      </div><div class="actions">
        <a class="text-link" href={link('guild', 'performance/')}
          >Read the performance evidence notes ↗</a
        >
      </div>
    </article>
  </div>
</Shell>
